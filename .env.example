# Backend
PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Optional in local development. Required in production.
MONGODB_URI=mongodb+srv://<database-user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Frontend build environment (Netlify). This is public and must not contain secrets.
VITE_API_URL=http://localhost:3001
